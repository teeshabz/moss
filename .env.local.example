# Supabase Database
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_anon_key_here"

# Google Books API - optional; book search works without it (limited quota). Set for production.
# GOOGLE_BOOKS_API_KEY=""

# TMDB API - required for movie search
TMDB_API_KEY=your_tmdb_api_key

# Apple Music API - required for song/album search
APPLE_MUSIC_TEAM_ID=your_team_id
APPLE_MUSIC_KEY_ID=your_key_id
# Option A (recommended): path to .p8 file - avoids escaping issues
APPLE_MUSIC_PRIVATE_KEY_PATH=AuthKey_XXXXXXXXXX.p8
# Option B: inline key - use literal \n between lines, preserve all / and + in base64
# APPLE_MUSIC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
APPLE_MUSIC_STOREFRONT=us
